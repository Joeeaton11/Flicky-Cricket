rules_version = '2';
// Flicky Cricket — online duels and leaderboards (Nov 16). Every player signs in anonymously.
// To ban a player: create a document banned/{their uid} in the Firestore console (any content).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function okName(n) { return n is string && n.size() >= 1 && n.size() <= 14 && n.matches("^[A-Z0-9 _.'-]+$"); }
    function okLook(d) { return okName(d.name) && d.flag is string && d.flag.size() <= 16 && d.shirt is string && d.shirt.size() <= 20 && d.g in ['m', 'f']; }

    // a player's duel innings at one table: 12 balls (+ up to 8 sudden-death balls); other players chase it
    match /tables/{li}/innings/{id} {
      allow read: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'flag', 'shirt', 'g', 'trophies', 'log', 'sd', 'runs', 'wk', 't', 'at'])
        && request.resource.data.uid == request.auth.uid && okLook(request.resource.data)
        && request.resource.data.log is list && request.resource.data.log.size() == 12 && request.resource.data.log.hasOnly([0, 1, 2, 3, 4, 5, 6, 'W'])
        && request.resource.data.sd is list && request.resource.data.sd.size() <= 8 && request.resource.data.sd.hasOnly([0, 1, 2, 3, 4, 5, 6, 'W'])
        && request.resource.data.runs is int && request.resource.data.runs >= 0 && request.resource.data.runs <= 160
        && request.resource.data.wk is int && request.resource.data.trophies is int && request.resource.data.trophies >= 0 && request.resource.data.trophies < 100000
        && request.resource.data.t is int && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // leaderboards: one entry per player per board, and it can only go up
    match /boards/{key}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'flag', 'shirt', 'g', 'score', 'at'])
        && request.resource.data.uid == uid && okLook(request.resource.data)
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000
        && request.resource.data.at == request.time
        && (resource == null || request.resource.data.score > resource.data.score);
    }

    // reports of offensive names (read them in the Firebase console)
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'uid', 'name', 'why', 't', 'at']);
    }

    // CLUBS (Nov 16): up to 30 players; the member count only moves by one, together with that member's own document
    function okClub(n) { return n is string && n.size() >= 3 && n.size() <= 16 && n.matches("^[A-Z0-9 _.'-]+$"); }
    function clubPath(cd) { return /databases/$(database)/documents/clubs/$(cd); }
    function memPath(cd, u) { return /databases/$(database)/documents/clubs/$(cd)/members/$(u); }
    match /clubs/{cd} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn() && cd.matches("^[A-Z0-9]{6}$")
        && request.resource.data.keys().hasOnly(['name', 'nameU', 'c', 's', 'owner', 'members', 't'])
        && okClub(request.resource.data.name) && request.resource.data.nameU == request.resource.data.name
        && request.resource.data.c is int && request.resource.data.c >= 0 && request.resource.data.c < 8
        && request.resource.data.s is int && request.resource.data.s >= 0 && request.resource.data.s < 6
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == 1
        && existsAfter(memPath(cd, request.auth.uid));
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && ((request.resource.data.members == resource.data.members + 1 && request.resource.data.members <= 30
              && !exists(memPath(cd, request.auth.uid)) && existsAfter(memPath(cd, request.auth.uid)))
          || (request.resource.data.members == resource.data.members - 1 && request.resource.data.members >= 0 && exists(memPath(cd, request.auth.uid))));
      match /members/{u} {
        allow get: if signedIn();
        allow list: if signedIn() && request.query.limit <= 50;
        allow create: if signedIn() && u == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'flag', 'week', 'pts', 'joined'])
          && request.resource.data.uid == u && okName(request.resource.data.name) && request.resource.data.flag is string && request.resource.data.flag.size() <= 16
          && request.resource.data.pts == 0 && request.resource.data.week is string
          && (getAfter(clubPath(cd)).data.members == (exists(clubPath(cd)) ? get(clubPath(cd)).data.members + 1 : 1));
        allow update: if signedIn() && u == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'flag', 'week', 'pts', 'joined'])
          && request.resource.data.uid == u && okName(request.resource.data.name) && request.resource.data.flag is string && request.resource.data.flag.size() <= 16
          && request.resource.data.pts is int && request.resource.data.week is string
          && ((request.resource.data.week == resource.data.week && request.resource.data.pts > resource.data.pts && request.resource.data.pts <= resource.data.pts + 5)
            || (request.resource.data.week != resource.data.week && request.resource.data.pts >= 0 && request.resource.data.pts <= 5));
        // leave (yourself) or removed by the captain; the club's count drops by one in the same write
        allow delete: if signedIn() && (u == request.auth.uid || get(clubPath(cd)).data.owner == request.auth.uid)
          && getAfter(clubPath(cd)).data.members == get(clubPath(cd)).data.members - 1;
      }
    }
    // weekly club totals (the TOP CLUBS board); only a member can add, at most 5 points a write
    match /clubweeks/{w}/clubs/{cd} {
      allow read: if signedIn();
      allow create, update: if signedIn() && exists(memPath(cd, request.auth.uid))
        && request.resource.data.keys().hasOnly(['pts', 'name', 'c', 's'])
        && okClub(request.resource.data.name) && request.resource.data.c is int && request.resource.data.s is int
        && request.resource.data.pts is int
        && request.resource.data.pts <= (resource == null ? 0 : resource.data.pts) + 5
        && request.resource.data.pts > (resource == null ? 0 : resource.data.pts);
    }

    // MATES referrals (Nov 13, merged Nov 17). refs/{code}: owner = the inviter's anonymous uid, club = their club code.
    // refs/{code}/mates/{uid}: one per friend, written by that friend after their first match; q = they stuck with it.
    match /refs/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.owner == request.auth.uid && request.resource.data.keys().hasOnly(['owner', 'at', 'club']);
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['club'])
        && request.resource.data.club is string && request.resource.data.club.size() <= 6;
      match /mates/{uid} {
        allow list: if signedIn() && get(/databases/$(database)/documents/refs/$(code)).data.owner == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && get(/databases/$(database)/documents/refs/$(code)).data.owner != request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'n']) && request.resource.data.n is string && request.resource.data.n.size() <= 14;
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q']) && request.resource.data.q == true;
      }
    }
  }
}
