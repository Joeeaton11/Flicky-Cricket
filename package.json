{
  "name": "flicky-cricket",
  "version": "1.0.0",
  "description": "Flicky Cricket - mobile cricket game",
  "scripts": {
    "build": "cp flicky-cricket.html www/index.html && rm -rf www/assets && cp -r assets www/assets",
    "sync": "npm run build && npx cap sync",
    "open:ios": "npm run sync && npx cap open ios",
    "open:android": "npm run sync && npx cap open android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/crashlytics": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@idleflowgames/capacitor-play-games": "0.3.3",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "patch-package": "8.0.0",
    "playwright": "^1.62.1"
  }
}
